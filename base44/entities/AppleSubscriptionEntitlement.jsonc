{
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "original_transaction_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "app_account_token": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "revoked"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "type": "string",
      "enum": [
        "Sandbox",
        "Production"
      ]
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "original_transaction_id",
    "product_id",
    "status",
    "expires_at"
  ],
  "rls": {
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "AppleSubscriptionEntitlement"
}