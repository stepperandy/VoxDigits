{
  "name": "DeviceFingerprint",
  "type": "object",
  "properties": {
    "fingerprint": {
      "type": "string",
      "description": "Stable device fingerprint hash (browser + hardware signals)"
    },
    "user_email": {
      "type": "string",
      "description": "Current account that owns this device"
    },
    "free_credits_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the one-time 25 free credits were claimed on this device"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "blocked"
      ],
      "default": "active",
      "description": "Device registry status \u2014 blocked devices cannot claim free credits or register new accounts"
    },
    "linked_accounts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Every account email ever associated with this device"
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Optional notes (up to 1000 characters)",
      "maxLength": 1000
    }
  },
  "required": [
    "fingerprint",
    "user_email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}