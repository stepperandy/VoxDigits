{
  "name": "Android Update Notification",
  "description": "Triggers onDownloadChanged when a new Android VPN installer is created or updated in the Download entity, creating an AppNotification for Android users.",
  "trigger": {
    "condition": "${ (.trigger.data.platform == \"Android\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Download"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "android_update_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onDownloadChanged",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onDownloadChanged"
  }
}