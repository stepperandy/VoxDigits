{
  "name": "IndexNow \u2014 AppNotification Changes",
  "description": "Submits the homepage to IndexNow whenever an AppNotification is created or updated",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "AppNotification"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "indexnow_appnotification_changes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "submitToIndexNow",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "submitToIndexNow"
  }
}