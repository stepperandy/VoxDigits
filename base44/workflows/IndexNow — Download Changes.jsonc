{
  "name": "IndexNow \u2014 Download Changes",
  "description": "Submits /download and homepage to IndexNow whenever a Download record is created or updated",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Download"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "indexnow_download_changes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "submitToIndexNow",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "submitToIndexNow"
  }
}