{
  "name": "voxvpn-shield-agent",
  "version": "3.0.1",
  "description": "VoxVPN Shield Agent — VPN + DNS Protection",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "build:renderer": "vite build",
    "build:win": "npm run build:renderer && electron-builder --win nsis"
  },
  "build": {
    "appId": "net.voxvpn.shield",
    "productName": "VoxShield",
    "artifactName": "VoxVPN-Shield-Setup-v${version}-10-Servers.${ext}",
    "copyright": "Copyright © 2026 VoxDigits Communications LLC",
    "directories": {
      "output": "../installer/voxshield/output"
    },
    "files": [
      "main.js",
      "preload.js",
      "api.js",
      "*.jsx",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "wait-on": "^7.2.0"
  }
}
